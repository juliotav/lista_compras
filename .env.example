ADMOB_APP_ID_IOS=ca-app-pub-XXXXXXXXXXXXXXXXXXX~YYYYYYYYY

# AdMob Banner Unit IDs para Producción (ENV=pr)
ADMOB_BANNER_ID_ANDROID_PR=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
ADMOB_BANNER_ID_IOS_PR=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ

ADMOB_INTERSTITIAL_ID_ANDROID_PR=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
ADMOB_INTERSTITIAL_ID_IOS_PR=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ

# Configuración de Notificaciones Push (Hostinger PHP + Firebase FCM)
